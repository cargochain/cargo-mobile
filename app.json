{
  "expo": {
    "name": "Cargo",
    "slug": "cargo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cargo-logo.png",
    "scheme": "cargo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cargo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of the shipment.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save photos of the shipment.",
        "NSFaceIDUsageDescription": "This app uses Face ID to securely authenticate you.",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cargo-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cargoespresso.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cargo-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf4ee"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take photos of the shipment.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record audio of the shipment.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload images of the shipment."
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a777e2a3-14a0-4950-b433-f831e271e4f9"
      }
    },
    "owner": "phenvrc"
  }
}